				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># Runs print-label on each selected PDF. Uses the default printer and its default settings.
for f in "$@"; do
  name=$(basename "$f")
  if out=$("$HOME/.local/bin/print-label"  "$f" 2&gt;&amp;1); then
    osascript - "$name" &lt;&lt;'EOS'
on run argv
  display notification "Barcode verified and sent to the printer." with title ("Printed " &amp; item 1 of argv)
end run
EOS
  else
    osascript - "$name" "$(printf '%s' "$out" | tail -6)" &lt;&lt;'EOS'
on run argv
  display alert ("Couldn't print " &amp; item 1 of argv) message (item 2 of argv) as critical
end run
EOS
  fi
done
</string>
					<key>CheckedForUserDefaultShell</key>
